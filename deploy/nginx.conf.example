# Example only. Terminate TLS at the hosting provider or this proxy.
# Replace certificate paths and the server name. Do not commit real secrets.

limit_req_zone $binary_remote_addr zone=obs_predict:10m rate=30r/m;
limit_conn_zone $binary_remote_addr zone=obs_conn:10m;

server {
    listen 80;
    server_name observatory.example.org;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name observatory.example.org;

    ssl_certificate     /etc/letsencrypt/live/observatory.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/observatory.example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 2m;
    limit_conn obs_conn 20;

    # Gradio queue join is the event-submission path. Verify the exact route
    # names against the installed Gradio version before relying on this limit.
    location /gradio_api/queue/join {
        limit_req zone=obs_predict burst=10 nodelay;
        proxy_pass http://127.0.0.1:7860;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:7860;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # For a private deployment add authentication here, for example:
    # auth_basic "Acoustic Observatory";
    # auth_basic_user_file /etc/nginx/.htpasswd;
}
